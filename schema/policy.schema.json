{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Profile export policy 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "allow_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "allow_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  }
}
